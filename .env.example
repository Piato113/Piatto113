# Copia aquest fitxer com a .env i omple els valors del teu projecte de Supabase.
# El fitxer .env no es puja mai a GitHub.
#
# Només s'hi posa la URL del projecte i la clau PÚBLICA (anon / publishable).
# La clau secreta (service_role / secret) NO s'ha de posar mai aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
